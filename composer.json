{
    "name": "laminas-api-tools/api-tools-doctrine",
    "description": "Laminas API Tools Doctrine module",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "api",
        "doctrine"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-doctrine/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-doctrine",
        "rss": "https://github.com/laminas-api-tools/api-tools-doctrine/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
          "php": "8.1.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "module": [
                "Laminas\\ApiTools\\Doctrine\\Admin",
                "Laminas\\ApiTools\\Doctrine\\Server"
            ]
        }
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "doctrine/collections": "^1 || ^2",
        "doctrine/doctrine-laminas-hydrator": "^3.2.1",
        "doctrine/doctrine-module": "^5.0.0 || ^6.0.0",
        "doctrine/persistence": "^2.0 || ^3.0",
        "laminas-api-tools/api-tools-api-problem": "^1.6",
        "laminas-api-tools/api-tools-configuration": "^1.6",
        "laminas-api-tools/api-tools-content-negotiation": "^1.7",
        "laminas-api-tools/api-tools-rest": "^1.7.0",
        "laminas/laminas-eventmanager": "^3",
        "laminas/laminas-filter": "^2",
        "laminas/laminas-hydrator": "^3.0 || ^4.0",
        "laminas/laminas-inputfilter": "^2.31",
        "laminas/laminas-modulemanager": "^2.17",
        "laminas/laminas-mvc": "^3.0.2",
        "laminas/laminas-paginator": "^2.19",
        "laminas/laminas-servicemanager": "^3.23",
        "laminas/laminas-stdlib": "^3.3",
        "laminas/laminas-validator": "^2.64",
        "laminas/laminas-view": "^2.11.3"
    },
    "require-dev": {
        "doctrine/doctrine-mongo-odm-module": "^5.0.0 || ^5.0.0",
        "doctrine/doctrine-orm-module": "^5.0.0 || ^6.0.0",
        "doctrine/mongodb-odm": "^2.0.0",
        "laminas-api-tools/api-tools-admin": "^2.0.1",
        "laminas-api-tools/api-tools-admin-ui": "^2.1",
        "laminas-api-tools/api-tools-hal": "^1.6.1",
        "laminas/laminas-coding-standard": "^3",
        "laminas/laminas-http": "^2.20",
        "laminas/laminas-test": "^4.8",
        "mongodb/mongodb": "^1.1.0",
        "phpspec/prophecy": "^1.15.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^10",
        "psalm/plugin-phpunit": "^0.19",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "vimeo/psalm": "^5"
    },
    "conflict": {
        "doctrine/dbal": "<2.12.0",
        "doctrine/orm": "<2.6.3"
    },
    "suggest": {
        "laminas-api-tools/api-tools-admin": "Admin interface",
        "api-skeletons/zf-doctrine-hydrator": "Hydrator strategies for Doctrine in Laminas API Tools",
        "api-skeletons/zf-oauth2-doctrine": "OAuth2 Doctrine Adapter for Laminas API Tools",
        "doctrine/doctrine-mongo-odm-module": "For Mongo ODM mapping",
        "doctrine/doctrine-orm-module": "For ORM mapping"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\Doctrine\\": "test/src/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "replace": {
        "zfcampus/zf-apigility-doctrine": "^2.3.0"
    },
    "repositories": [
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-api-problem"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-hal"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-content-negotiation"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-content-validation"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-provider"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-oauth2"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-mvc-auth"
      },
      {
        "type": "git",
        "url": "https://github.com/datasage/api-tools-rest"
      }
    ]
}
