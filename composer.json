{
    "name": "laminas-api-tools/api-tools-doctrine",
    "description": "Laminas API Tools Doctrine module",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "api",
        "doctrine"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-doctrine/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-doctrine",
        "rss": "https://github.com/laminas-api-tools/api-tools-doctrine/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "module": [
                "Laminas\\ApiTools\\Doctrine\\Server"
            ]
        }
    },
    "require": {
        "doctrine/collections": "^2",
        "doctrine/doctrine-laminas-hydrator": "^3.2.1",
        "doctrine/doctrine-module": "^6.4",
        "doctrine/persistence": "^3 || ^4",
        "laminas-api-tools/api-tools-api-problem": "^1.10",
        "laminas-api-tools/api-tools-content-negotiation": "^1.11",
        "laminas-api-tools/api-tools-rest": "^1.10",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-hydrator": "^4.17",
        "laminas/laminas-inputfilter": "^2.34",
        "laminas/laminas-modulemanager": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-paginator": "^2.21",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.21",
        "laminas/laminas-validator": "^2.65",
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "doctrine/doctrine-orm-module": "^6.4",
        "laminas-api-tools/api-tools": "^1.9",
        "laminas-api-tools/api-tools-hal": "^1.13",
        "laminas-api-tools/api-tools-provider": "^1.8",
        "laminas-api-tools/api-tools-rpc": "^1.10",
        "laminas-api-tools/api-tools-versioning": "^1.9",
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-filter": "^2.42",
        "laminas/laminas-http": "^2.23 || ^3.0",
        "laminas/laminas-i18n": "^2.31",
        "laminas/laminas-test": "^4.13",
        "phpspec/prophecy": "^1.15.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.14"
    },
    "conflict": {
        "doctrine/dbal": "<2.12.0",
        "doctrine/orm": "<2.6.3"
    },
    "suggest": {
        "doctrine/doctrine-orm-module": "For ORM mapping"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\Doctrine\\": "test/src/",
            "LaminasTestApiToolsDb\\": "test/assets/module/LaminasTestApiToolsDb/src/LaminasTestApiToolsDb",
            "LaminasTestApiToolsDbApi\\": "test/assets/module/LaminasTestApiToolsDbApi/src/LaminasTestApiToolsDbApi",
            "LaminasTestApiToolsGeneral\\": "test/assets/module/LaminasTestApiToolsGeneral/src/LaminasTestApiToolsGeneral"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "replace": {
        "zfcampus/zf-apigility-doctrine": "^2.3.0"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-api-problem"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-hal"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-content-negotiation"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-content-validation"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-provider"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-oauth2"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-mvc-auth"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-rest"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/laminas-mvc"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/laminas-test"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/DoctrineModule"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/DoctrineORMModule"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-rpc"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-versioning"
        }
    ]
}
